# Скопируйте в .env и при желании поменяйте пароли: cp .env.example .env
# Файл .env не коммитится в git.

# БД пользователей (только для auth-service)
USERS_DB_NAME=users
USERS_DB_USER=auth_service
USERS_DB_PASSWORD=change-me-users

# БД видео (для api и video-worker)
VIDEO_DB_NAME=videos
VIDEO_DB_USER=video_service
VIDEO_DB_PASSWORD=change-me-videos

# Кеш
REDIS_PASSWORD=change-me-redis

# Брокер сообщений
RABBITMQ_USER=vidsec
RABBITMQ_PASSWORD=change-me-rabbit
# Общий секрет узлов кластера RabbitMQ
RABBITMQ_ERLANG_COOKIE=change-me-erlang-cookie-vidsec

# Хранилище файлов (S3)
STORAGE_URL=http://storage:8333
S3_ACCESS_KEY=vidsec
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=videos

# Резервное копирование: интервал (с) и сколько копий хранить
BACKUP_INTERVAL=3600
BACKUP_KEEP=24

# Время жизни JWT, секунд
JWT_TTL_SECONDS=3600
